[
  { "id": "v01", "text": "The night boat held the dark.", "voice": "af_heart", "speed": 0.9 },
  { "id": "v02", "text": "She waited for the other drum.", "voice": "af_heart", "speed": 0.9 },
  { "id": "v03", "text": "Pink came in with the mail.", "voice": "af_heart", "speed": 0.9 },
  { "id": "v04", "text": "They looked, and did not touch.", "voice": "af_heart", "speed": 0.9 },
  { "id": "v05", "text": "Where the wakes crossed, a path.", "voice": "af_heart", "speed": 0.9 },
  { "id": "v06", "text": "Home.", "voice": "af_heart", "speed": 0.9 }
